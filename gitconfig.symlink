[user]
	name = mmatokovic
	email = 27929908+mmatokovic@users.noreply.github.com
[alias]
    fpush = push --force-with-lease
	rebase = pull --rebase
[tag]
    sort = version:refname
[init]
    templatedir = ~/dotfiles/.github
	defaultBranch = main
[includeIf "gitdir:~/source/repos/crosig/"]
    path = ~/source/repos/crosig/.gitconfig
[core]
	longpaths = true
	editor = code --wait
	ignorecase = false
	autocrlf = true
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[push]
	default = simple
	autoSetupRemote = true
	followTags = true
[fetch]
	prune = true
	pruneTags = true
	all = true
[help]
	autocorrect = prompt
[commit]
	verbose = true
[rerere]
	enabled = true
	autoupdate = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[merge]
	conflictstyle = zdiff3
[pull]
	rebase = true
[maintenance]
	repo = C:/Users/mmatokovic/source/repos/crosig/int-spring-project/einvoice-api
